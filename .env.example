# Optional overrides. The portal runs with NO .env file; these are the defaults already in
# docker-compose.yml. Copy to .env to change any of them.

# MUST change for any real deployment:
DJANGO_SECRET_KEY=insecure-compose-default-change-me
DEMO_MODE=1            # 0 = no demo accounts, no known passwords, no fixed tokens
COOKIE_SECURE=0        # 1 when served over HTTPS

PORTAL_PORT=8080       # host port; change base_url in .dogfood.toml too
ALLOW_SIGNUP=1         # 0 closes public sign-up
SEED_FIXTURES=1        # import acceptance/fixtures.json on boot; 0 for a real deployment

POSTGRES_DB=dogfood
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=dogfood

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Login throttle
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=30
LOGIN_FAILURE_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=0  # 1 only behind a reverse proxy you control

DEMO_PASSWORD=dogfood-demo
DEMO_TOKEN_ADMIN=dogfood-demo-admin-token
DEMO_TOKEN_ORGANIZER=dogfood-demo-organizer-token
DEMO_TOKEN_JUDGE_A=dogfood-demo-judge-a-token
DEMO_TOKEN_JUDGE_B=dogfood-demo-judge-b-token
DEMO_TOKEN_PARTICIPANT=dogfood-demo-participant-token
