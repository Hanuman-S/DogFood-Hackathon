# Optional. The portal runs correctly with NO .env file at all -- every value below is
# already the default baked into docker-compose.yml. Copy this to `.env` only when you want
# to change something:
#
#     cp .env.example .env
#
# Compose picks up a `.env` file in this directory automatically.


# ======================================================================================
# MUST CHANGE BEFORE PRODUCTION
# ======================================================================================

# INSECURE DEFAULT. The value shipped in docker-compose.yml is a known, public string, so
# every deployment that does not override it shares the same session-signing key. Generate
# one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
DJANGO_SECRET_KEY=insecure-compose-default-change-me-before-production

# 1 = seed demo accounts with the published password `dogfood-demo`, fixed API tokens, and an
# open "Dogfood Live Demo" event. This is how the portal gets to a usable state in one
# command, and it is completely unsuitable for a real event.
#
# 0 = no demo users, no known passwords, no fixed tokens. Bootstrap the first admin with:
#
#   docker compose exec web python /app/src/manage.py createsuperuser
#
DEMO_MODE=1

# Set to 1 when serving over HTTPS so session and CSRF cookies are marked Secure. Leaving it
# at 0 behind TLS means cookies can travel in clear text; setting it to 1 without TLS breaks
# login entirely, which is why the local default is 0.
COOKIE_SECURE=0


# ======================================================================================
# DATABASE
# ======================================================================================

POSTGRES_DB=dogfood
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=dogfood
# Only read by the web container; the db service always listens inside the compose network.
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ======================================================================================
# DJANGO
# ======================================================================================

# Keep this 0. DEBUG=1 serves tracebacks containing settings and query values to anyone who
# triggers an error.
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,web

# Browsers require the origin (scheme + host + port) to be trusted for cross-origin POSTs.
# Add your real hostname here when deploying, e.g. https://hack.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DJANGO_LOG_LEVEL=INFO


# ======================================================================================
# PORTAL BEHAVIOUR
# ======================================================================================

# Host port. .dogfood.toml and the README both advertise 8080; change both if you change
# this.
PORTAL_PORT=8080

# Where the organizer fixture file is read from inside the container. compose bind-mounts
# ./acceptance/fixtures.json here read-only.
FIXTURES_PATH=/app/acceptance/fixtures.json

# Gallery page size. 50 fits a whole hackathon cohort on one page.
GALLERY_PAGE_SIZE=50

# Login throttle: this many failures for the same (email, IP) within the window are refused.
# Counted from audit-log rows, so it survives restarts and applies across gunicorn workers.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Upload limits. Images are verified with Pillow, not trusted by file extension.
MAX_UPLOAD_BYTES=5242880
MAX_PROJECT_IMAGES=8
