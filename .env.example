# Optional. The portal runs correctly with NO .env file at all -- every value below is
# already the default baked into docker-compose.yml. Copy this to `.env` only when you want
# to change something:
#
#     cp .env.example .env
#
# Compose picks up a `.env` file in this directory automatically.


# ======================================================================================
# MUST CHANGE BEFORE PRODUCTION
# ======================================================================================

# INSECURE DEFAULT. The value shipped in docker-compose.yml is a known, public string, so
# every deployment that does not override it shares the same session-signing key. Generate
# one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
DJANGO_SECRET_KEY=insecure-compose-default-change-me-before-production

# 1 = seed demo accounts with the published password `dogfood-demo`, fixed API tokens, and an
# open "Dogfood Live Demo" event. This is how the portal gets to a usable state in one
# command, and it is completely unsuitable for a real event.
#
# 0 = no demo users, no known passwords, no fixed tokens. Bootstrap the first admin with:
#
#   docker compose exec web python /app/src/manage.py createsuperuser
#
DEMO_MODE=1

# Import the organizers' shared fixture data (1 event, 8 tracks, 30 judges, 40 teams,
# 41 projects, 126 scores) on every boot.
#
# SET THIS TO 0 FOR A REAL DEPLOYMENT. You do not want 121 invented accounts and a closed
# March-2026 event in a database you are running an actual hackathon on.
#
# It defaults to 1 because `docker compose up` has to reach a portal whose gallery genuinely
# shows the fixture projects, which is what the acceptance checker looks for.
#
# The import is create-only: it inserts rows that are missing and never modifies rows that
# already exist, so leaving it on cannot revert a deliberate edit such as an organizer extending
# a deadline. Divergences are reported at boot, not silently overwritten. To make the fixture win
# on purpose, run it by hand:
#
#   docker compose exec web python /app/src/manage.py import_fixtures --sync
#
SEED_FIXTURES=1

# Set to 1 when serving over HTTPS so session and CSRF cookies are marked Secure. Leaving it
# at 0 behind TLS means cookies can travel in clear text; setting it to 1 without TLS breaks
# login entirely, which is why the local default is 0.
COOKIE_SECURE=0


# ======================================================================================
# DATABASE
# ======================================================================================

POSTGRES_DB=dogfood
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=dogfood
# Only read by the web container; the db service always listens inside the compose network.
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ======================================================================================
# DJANGO
# ======================================================================================

# Keep this 0. DEBUG=1 serves tracebacks containing settings and query values to anyone who
# triggers an error.
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,web

# Browsers require the origin (scheme + host + port) to be trusted for cross-origin POSTs.
# Add your real hostname here when deploying, e.g. https://hack.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DJANGO_LOG_LEVEL=INFO


# ======================================================================================
# PORTAL BEHAVIOUR
# ======================================================================================

# Host port. .dogfood.toml and the README both advertise 8080; change both if you change
# this.
PORTAL_PORT=8080

# Where the organizer fixture file is read from inside the container. compose bind-mounts
# ./acceptance/fixtures.json here read-only.
FIXTURES_PATH=/app/acceptance/fixtures.json

# Gallery page size. 50 fits a whole hackathon cohort on one page.
GALLERY_PAGE_SIZE=50

# Login throttle: this many failures for the same (email, IP) within the window are refused.
# Counted from audit-log rows, so it survives restarts and applies across gunicorn workers.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Upload limits. Images are verified with Pillow, not trusted by file extension.
MAX_UPLOAD_BYTES=5242880
MAX_PROJECT_IMAGES=8

# Trust X-Forwarded-For for the client IP. Leave at 0 unless a reverse proxy you control sets
# the header: it is client-supplied, so trusting it without a proxy lets anyone forge the IP the
# login throttle counts against and lock someone else out.
TRUST_PROXY_HEADERS=0


# ======================================================================================
# DEMO CREDENTIALS (ignored entirely when DEMO_MODE=0)
# ======================================================================================

# The password every demo and imported fixture account shares. Published on purpose.
DEMO_PASSWORD=dogfood-demo

# API tokens with fixed values, so .dogfood.toml stays valid across `docker compose down -v`.
# Random per-boot tokens would invalidate that file every time the database was reset. These are
# hashed into the database exactly like any user-created token; only their origin differs.
#
# No value may contain `#`: the acceptance checker's fallback TOML parser truncates a line at
# the first one. Keep to [A-Za-z0-9_-].
DEMO_TOKEN_ORGANIZER=dogfood-demo-organizer-token-do-not-use-in-production
DEMO_TOKEN_JUDGE_A=dogfood-demo-judge-a-token-do-not-use-in-production
DEMO_TOKEN_JUDGE_B=dogfood-demo-judge-b-token-do-not-use-in-production
DEMO_TOKEN_PARTICIPANT=dogfood-demo-participant-token-do-not-use-in-production
DEMO_TOKEN_ADMIN=dogfood-demo-admin-token-do-not-use-in-production

# Fixed invite token for the demo team, so the printed invite URL survives a database reset.
DEMO_INVITE_TOKEN=dogfood-demo-invite-token-not-for-production

# Only used to print clickable links in the boot credentials block.
PORTAL_BASE_URL=http://localhost:8080
